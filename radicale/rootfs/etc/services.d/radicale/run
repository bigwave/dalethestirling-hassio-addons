#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start Radicale CalDAV/CardDAV service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

CONFIG_DIR="/config"
CONFIG_FILE="${CONFIG_DIR}/config"
RIGHTS_FILE="${CONFIG_DIR}/rights"
USERS_FILE="${CONFIG_DIR}/users"
LOGGING_FILE="${CONFIG_DIR}/logging"

LOG_LEVEL=$(bashio::config 'log_level')
STORAGE_LOC=$(bashio::config 'storage_location')

bashio::log.info "Starting Radicale add-on initialisation..."

# Ensure configuration directory exists
mkdir -p "${CONFIG_DIR}"

# Determine collections storage directory based on user option
STORAGE_DIR="${CONFIG_DIR}/collections"
if bashio::config.equals 'storage_location' 'share'; then
    STORAGE_DIR="/share/radicale/collections"
elif bashio::config.equals 'storage_location' 'internal'; then
    STORAGE_DIR="/data/collections"
elif bashio::config.equals 'storage_location' 'addon_config'; then
    STORAGE_DIR="${CONFIG_DIR}/collections"
fi

mkdir -p "${STORAGE_DIR}"
bashio::log.info "Using storage location: ${STORAGE_DIR}"

# Determine log level upper case
LOG_LEVEL_UPPER=$(echo "${LOG_LEVEL:-info}" | tr '[:lower:]' '[:upper:]')

# Create default logging configuration if not present
if [ ! -f "${LOGGING_FILE}" ]; then
    cat << EOF > "${LOGGING_FILE}"
[loggers]
keys = root

[handlers]
keys = console

[formatters]
keys = simple

[logger_root]
level = ${LOG_LEVEL_UPPER}
handlers = console

[handler_console]
class = StreamHandler
level = DEBUG
formatter = simple
args = (sys.stdout,)

[formatter_simple]
format = %(asctime)s - [%(process)d] %(levelname)s: %(message)s
datefmt = %Y-%m-%d %H:%M:%S
EOF
    bashio::log.info "Created default logging configuration at ${LOGGING_FILE}"
else
    # Update log level in existing logging file if not in custom config mode
    if ! bashio::config.true 'custom_config'; then
        sed -i "s/^level = .*/level = ${LOG_LEVEL_UPPER}/" "${LOGGING_FILE}" || true
    fi
fi

# Create default rights configuration if not present
if [ ! -f "${RIGHTS_FILE}" ]; then
    cat << 'EOF' > "${RIGHTS_FILE}"
# Radicale Rights Management File
# Reference: https://radicale.org/v3.html#rights

# Allow root CalDAV/CardDAV discovery
[root]
user = .+
collection =
permission = r

# Allow internal web interface access
[web]
user = .+
collection = \.web
permission = r

# Allow users full read/write access to their own collections
[owner-write]
user = .+
collection = {user}(/.*)?
permission = rw
EOF
    bashio::log.info "Created default rights configuration at ${RIGHTS_FILE}"
fi

# Create default Radicale configuration if not present
if [ ! -f "${CONFIG_FILE}" ]; then
    cat << EOF > "${CONFIG_FILE}"
# Radicale Configuration File
# Reference: https://radicale.org/v3.html#configuration

[server]
hosts = 0.0.0.0:5232
max_connections = 20
max_content_length = 100000000
timeout = 30

[auth]
type = htpasswd
htpasswd_filename = ${USERS_FILE}
htpasswd_encryption = bcrypt
delay = 1

[rights]
type = from_file
file = ${RIGHTS_FILE}

[storage]
type = multifilesystem
filesystem_folder = ${STORAGE_DIR}
filesystem_locking = True

[web]
type = internal

[logging]
config = ${LOGGING_FILE}
EOF
    bashio::log.info "Created default Radicale configuration at ${CONFIG_FILE}"
fi

# Manage users from add-on options when custom_config is false
if ! bashio::config.true 'custom_config'; then
    if bashio::config.has_value 'users'; then
        bashio::log.info "Configuring users from add-on options..."
        rm -f "${USERS_FILE}"
        touch "${USERS_FILE}"

        for user in $(bashio::config 'users|keys'); do
            USERNAME=$(bashio::config "users[${user}].username")
            PASSWORD=$(bashio::config "users[${user}].password")

            if [ -n "${USERNAME}" ] && [ -n "${PASSWORD}" ]; then
                htpasswd -b -B "${USERS_FILE}" "${USERNAME}" "${PASSWORD}" > /dev/null 2>&1
                bashio::log.info "Configured user: ${USERNAME}"
            fi
        done
    fi
fi

# Ensure htpasswd file exists (create default admin if file is missing or empty)
if [ ! -f "${USERS_FILE}" ] || [ ! -s "${USERS_FILE}" ]; then
    bashio::log.warning "No users found in ${USERS_FILE}. Creating initial admin user (admin / admin)..."
    htpasswd -c -b -B "${USERS_FILE}" "admin" "admin" > /dev/null 2>&1
    bashio::log.warning "Please update credentials in the Add-on Configuration or directly in ${USERS_FILE}!"
fi

bashio::log.info "Starting Radicale CalDAV/CardDAV service on port 5232..."
exec radicale --config "${CONFIG_FILE}"
